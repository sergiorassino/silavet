# Copiar a scripts/emergencia/config.env (chmod 600) si no hay sudo.
# Alternativa con root: /etc/silavet/config.env
# No commitear valores reales.

# Identificador del laboratorio en S3 (carpeta de archivos y filtro de dumps).
PROYECTO=alqu

# Carpeta del proyecto Laravel (donde está artisan). NO es la URL.
APP_DIR=/home/admin/public_html/silavet/alqu

# Usuario/grupo del PHP (sin sudo: el mismo con el que entras por SSH).
WEB_USER=admin
WEB_GROUP=admin

# Git (solo VPS de emergencia).
GIT_URL=https://github.com/sergiorassino/silavet.git
GIT_BRANCH=main

# PHP y Composer (rutas si no están en PATH).
# DirectAdmin AlmaLinux: NO uses el `php` del sistema. Usá el del panel:
#   ls -d /usr/local/php*/bin/php
#   PHP_BIN=/usr/local/php83/bin/php
PHP_BIN=/usr/local/php83/bin/php

# Overlay de APP_URL / DB_* (sin sudo: junto a este archivo).
ENV_EMERGENCIA_FILE=/home/admin/public_html/silavet/alqu/scripts/emergencia/env.emergencia

# Bucket y prefijos. Ajustar si el nombre real de la carpeta de dumps difiere
# (en el servidor actual aparece como backupDedicdo/backupHora).
S3_BUCKET=sistesco
S3_PREFIX_DUMPS=backupDedicdo/backupHora
S3_PREFIX_ARCHIVOS=backupDedicado/archivos
# Subcadena que debe aparecer en la clave del dump (nombre de archivo o carpeta).
S3_DUMP_FILTER=labvetciudad
# Región del bucket; vacío = la de `aws configure`.
AWS_REGION=
# Ruta absoluta al binario si `aws` no está en PATH (hosting compartido).
# Ejemplo Hostinger: AWS_BIN=/home/u577894275/.local/bin/aws
AWS_BIN=

# MySQL del VPS de emergencia (el overlay pisa DB_* del .env de producción).
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=silavet
MYSQL_PASSWORD=__CAMBIAR__
MYSQL_DATABASE=lb_labvetciudad
