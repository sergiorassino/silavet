# Un solo archivo por SERVIDOR (no por laboratorio).
# Preferido: ~/.silavet/config.env  o  /etc/silavet/config.env
# Los datos de cada lab (tenant, LAB_ORDEN, MySQL de emergencia) van en su .env.
# No commitear valores reales.

# SOLO en el hosting de producción (Hostinger). En el VPS de emergencia: 0
HABILITAR_RESPALDO=0

# Carpeta que contiene un subdirectorio por tenant (con artisan).
# Cron de todos los labs: respaldar-todos.sh
# SILAVET_ROOT=/home/USUARIO/public_html/silavet

# Usuario/grupo del PHP (DirectAdmin: admin).
WEB_USER=admin
WEB_GROUP=admin

# Git (VPS de emergencia).
GIT_URL=https://github.com/sergiorassino/silavet.git
GIT_BRANCH=main

# DirectAdmin: PHP del panel, no el de AlmaLinux.
PHP_BIN=/usr/local/php83/bin/php

S3_BUCKET=sistesco
S3_PREFIX_DUMPS=backupDedicado/backupHora
S3_PREFIX_ARCHIVOS=backupDedicado/archivos

# mysqldump si no está en PATH.
MYSQLDUMP_BIN=

# Región del bucket. No dejes AWS_REGION= vacío (rompe el endpoint S3).
AWS_REGION=sa-east-1
# Hostinger: AWS_BIN=/home/USUARIO/.local/bin/aws
AWS_BIN=
