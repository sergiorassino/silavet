# Defaults impersonales por laboratorio.
# Copiar a scripts/emergencia/config.env (mismo contenido en todos los labs/hostings).
# Personalización (AWS_BIN, HABILITAR_RESPALDO, tenant, MySQL emergencia) → .env Laravel.
# No commitear config.env (está en .gitignore).

# Usuario/grupo del PHP (DirectAdmin: admin).
WEB_USER=admin
WEB_GROUP=admin

# Git (VPS de emergencia).
GIT_URL=https://github.com/sergiorassino/silavet.git
GIT_BRANCH=main

# DirectAdmin: PHP del panel, no el de AlmaLinux.
PHP_BIN=/usr/local/php83/bin/php

S3_BUCKET=sistesco
S3_PREFIX_DUMPS=backupDedicado/backupHora
S3_PREFIX_ARCHIVOS=backupDedicado/archivos

# Región del bucket. No dejes AWS_REGION= vacío (rompe el endpoint S3).
AWS_REGION=sa-east-1

# Restaurar desde el celular (public/emergencia-restaurar.php).
# Van en este archivo para que cada lab las herede al copiar → config.env.
# Misma clave en todos los labs. En Hostinger la página queda 404 (host y
# HABILITAR_RESPALDO=1). Para rotar: cambiá el token acá y en cada config.env.
HABILITAR_RESTAURAR_WEB=1
RESTAURAR_WEB_TOKEN=4ab8fff13f4fbe520721b42c58392257e34ac8bf17c9f135af829cad40a6e7ee
RESTAURAR_WEB_HOST=sistemasescolares4.com.ar,sistemasescolares4.com
