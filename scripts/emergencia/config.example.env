# Por laboratorio: copiar a scripts/emergencia/config.env (junto a este archivo).
# Ejemplo: …/silavet/alqu/scripts/emergencia/config.env
# No commitear config.env (está en .gitignore).
# Datos del lab (tenant, LAB_ORDEN, MySQL de emergencia) van en el .env Laravel.

# SOLO en el hosting de producción. En el VPS de emergencia: 0
HABILITAR_RESPALDO=0

# Usuario/grupo del PHP (DirectAdmin: admin).
WEB_USER=admin
WEB_GROUP=admin

# Git (VPS de emergencia).
GIT_URL=https://github.com/sergiorassino/silavet.git
GIT_BRANCH=main

# DirectAdmin: PHP del panel, no el de AlmaLinux.
PHP_BIN=/usr/local/php83/bin/php

S3_BUCKET=sistesco
S3_PREFIX_DUMPS=backupDedicado/backupHora
S3_PREFIX_ARCHIVOS=backupDedicado/archivos

# Zona horaria de nombres de dump y logs (por defecto Argentina).
# SILAVET_TZ=America/Argentina/Buenos_Aires

# mysqldump si no está en PATH.
MYSQLDUMP_BIN=

# Región del bucket. No dejes AWS_REGION= vacío (rompe el endpoint S3).
AWS_REGION=sa-east-1
# Hostinger: AWS_BIN=/home/USUARIO/.local/bin/aws
AWS_BIN=
