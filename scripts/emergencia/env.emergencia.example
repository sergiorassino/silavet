# Copiar a /etc/silavet/env.emergencia (chmod 600).
# Vive SOLO en el VPS de emergencia: al restaurar pisa estas claves del .env
# bajado de S3 (producción). El resto del .env se conserva (APP_KEY, mail, AFIP, etc.).

APP_ENV=production
APP_DEBUG=false
APP_URL=https://__CAMBIAR__.ejemplo.com

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lb_labvetciudad
DB_USERNAME=silavet
DB_PASSWORD=__CAMBIAR__

SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=
